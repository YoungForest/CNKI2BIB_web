{
  "name": "cnki2bib-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue,.js --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,css,scss,json}\""
  },
  "dependencies": {
    "jieba-wasm": "^2.2.0",
    "naive-ui": "^2.38.2",
    "pinyin-pro": "^3.23.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^14.3.9",
    "prettier": "^3.2.5",
    "typescript": "~6.0.3",
    "vite": "^5.1.6",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
